# Copy to /etc/occasion/hymns.env   (chown root:www-data, chmod 640). Read by BOTH the web app and cron.
# Never commit the real file.
HYMNS_API_BASE_URL=https://127.0.0.1/hymns
HYMNS_API_KEY=put-the-real-key-here
HYMNS_API_VERIFY_TLS=false        # set to true once there is a real domain with a valid certificate
HYMNS_CACHE_TTL_MIN=15
# HYMNS_PREFERRED_LANGS=ne,hi,en  # which language code to prefer when a hymn has several
# HYMNS_CACHE_DIR=/var/lib/occasion/hymns   # default: <app>/api/cache (denied by Apache)
